{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cumhuriyet Tarihi Arsivci Ajani State",
  "type": "object",
  "required": [
    "scope",
    "routes",
    "queries",
    "evidence_cards",
    "contradictions",
    "archive_log",
    "auth_status"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "required": [
        "topic",
        "date_range",
        "geography",
        "actors",
        "target_output"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "date_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "geography": {
          "type": "string"
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_output": {
          "type": "string",
          "enum": [
            "short_summary",
            "bibliography",
            "timeline",
            "mixed"
          ]
        }
      }
    },
    "routes": {
      "type": "object",
      "required": [
        "primary",
        "backups"
      ],
      "properties": {
        "primary": {
          "type": "object",
          "required": [
            "name",
            "rationale"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "backups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "name",
              "rationale"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route",
          "keywords",
          "person_variants",
          "institution_variants",
          "critical_dates"
        ],
        "properties": {
          "route": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "person_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "institution_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "critical_dates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_cards": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "archive_log": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "direct_source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "url"
        ],
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "auth_status": {
      "type": "object",
      "required": [
        "required",
        "stage"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "stage": {
          "type": "string",
          "enum": [
            "not_needed",
            "navigated_to_login",
            "waiting_user_login",
            "resumed"
          ]
        },
        "site": {
          "type": "string"
        },
        "session_handle": {
          "type": "string"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contradiction Ticket",
  "type": "object",
  "required": [
    "topic",
    "conflict",
    "sources",
    "hypotheses",
    "resolution_plan",
    "status"
  ],
  "properties": {
    "topic": {
      "type": "string"
    },
    "conflict": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "resolved",
        "unresolved"
      ]
    }
  }
}
